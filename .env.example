# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather. Required.
BOT_TOKEN=123456789:replace_me_with_your_own_token

# ── Mode ────────────────────────────────────────────────────────────────────
# polling: a standalone bot, as before.
# worker:  the bot lives on Telegram Serverless (serverless/ in this repo); this
#          container only runs the downloads it hands over. Use ./setup.sh public
#          and docker-compose.public.yml, which set it for you.
BOT_MODE=polling
# Shared with serverless/tgcloud/lib/secrets.js, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# WORKER_SECRET=
# A PC with no public address: the worker polls the bot for jobs instead of
# listening. The bot's Mini App address, https://app<id>.tgcloud.ai
# WORKER_SERVERLESS_URL=
# WORKER_POLL_SECONDS=3
# Without WORKER_SERVERLESS_URL the worker listens here (docker-compose.public.yml).
# WORKER_PORT=8080
# How many jobs may wait for a download slot before new ones are refused.
# WORKER_MAX_QUEUE=20

# ── Public setup (docker-compose.public.yml) ────────────────────────────────
# Worker and Cobalt behind HTTPS on one domain, for Telegram Serverless.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml
# PUBLIC_DOMAIN=dl.example.com

# ── Cobalt ──────────────────────────────────────────────────────────────────
# One or more instances, comma separated, in priority order. The first one is
# used for every request; the rest only take over when it cannot deliver
# (no YouTube session, rate limit, downtime).
#
# Keep your own instance first: a public one sees every link your users send
# and your bot's IP address, and its owner pays for the traffic.
# Public instances are listed at https://cobalt.directory - check one with
#   python -m app.instances --youtube https://api.example.org
# before trusting it, and respect whatever terms its owner set.
#
# Per-instance keys use the url|key form:
# COBALT_API_URL=http://cobalt:9000, https://api.example.org|their_key
COBALT_API_URL=http://cobalt:9000
# Fallback key applied to instances listed without their own.
# COBALT_API_KEY=replace_me

# ── Forced subscription (optional) ──────────────────────────────────────────
# Leave both empty to disable the check.
# The bot must be an administrator of the channel, otherwise it cannot read
# the member list and the check is skipped with a warning in the logs.
REQUIRED_CHANNEL=
REQUIRED_CHANNEL_URL=

# ── Limits and defaults ─────────────────────────────────────────────────────
# 50 is the hard Telegram limit for regular bots (2000 with a local Bot API server).
MAX_DOWNLOAD_MB=50

# ── Files over 50 MB: local Bot API server ──────────────────────────────────
# Start it with:  docker compose --profile local-api up -d
# 1. get api_id/api_hash at https://my.telegram.org/apps and fill them in
# 2. log the bot out of the cloud API once: python -m app.logout --yes
# 3. uncomment the URL below and raise MAX_DOWNLOAD_MB (up to 2000)
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# TELEGRAM_API_URL=http://telegram-bot-api:8081
# Keeps the server in every `docker compose up` — without it a plain `up`
# starts the bot with no API server to talk to.
# COMPOSE_PROFILES=local-api
# The server runs with TELEGRAM_LOCAL=1, so keep this true.
TELEGRAM_API_LOCAL_MODE=true
# Uploading 2 GB takes a while; this is the per-request timeout in seconds.
TELEGRAM_TIMEOUT=900
# 144 | 240 | 360 | 480 | 720 | 1080 | 1440 | 2160 | max
VIDEO_QUALITY=1080
# best | mp3 | ogg | wav | opus
AUDIO_FORMAT=mp3
AUDIO_BITRATE=128
# h264 plays everywhere; av1/vp9 are smaller but Telegram clients may struggle.
YOUTUBE_VIDEO_CODEC=h264
# Higher-bitrate audio track. Off by default: it is usually opus, which cannot be
# copied into mp4, so the instance has to transcode - and a failed transcode
# comes back as an empty file.
YOUTUBE_BETTER_AUDIO=false
# Pull every file through the instance instead of following its redirect.
# Reliable (YouTube practically needs it), but the instance carries the whole
# file. Set to false to spare a public instance's bandwidth where a direct
# link would do.
ALWAYS_PROXY=true

# ── YouTube via yt-dlp ──────────────────────────────────────────────────────
# yt-dlp fetches its own PO tokens, so YouTube keeps working even when the
# Cobalt session server is down. Set to false to route YouTube through Cobalt.
YTDLP_FOR_YOUTUBE=true
# If yt-dlp fails, try Cobalt anyway before giving up.
# Cobalt without a session server cannot do YouTube, so this only helps if one
# of the instances in COBALT_API_URL has its own working YouTube session.
YTDLP_FALLBACK_TO_COBALT=false
# Optional cookies file (Netscape format) for content your account may see.
# Mount it into the container first, e.g. ./cookies.txt:/cookies.txt:ro
# YTDLP_COOKIES_FILE=/cookies.txt
MAX_CONCURRENT_DOWNLOADS=3
API_TIMEOUT=60
DOWNLOAD_TIMEOUT=900
LOG_LEVEL=INFO
